# PRISM IDS Agent Sensor Configuration Example
AGENT_NAME="remote-agent-sensor-01"

# Set your Central PRISM Server URL here (IP or Domain)
SERVER_URL="http://192.168.1.50:8000"

HEARTBEAT_INTERVAL=15
RECONNECT_INTERVAL=5
HTTP_TIMEOUT=10.0

CREDENTIALS_FILE=".agent_credentials.json"

LOG_LEVEL="INFO"
LOG_FORMAT="json"
LOG_DIR="logs"
DEBUG=true
TIMEZONE="UTC"
