# PRISM IDS Agent Configuration Example

AGENT_NAME="agent-sensor-node-01"
SERVER_URL="http://localhost:8000"
WS_URL="ws://localhost:8000/ws/v1/connect"

# Telemetry & Heartbeat Intervals
HEARTBEAT_INTERVAL=15
RECONNECT_INTERVAL=5
HTTP_TIMEOUT=10.0

# Local Credentials Storage
CREDENTIALS_FILE=".agent_credentials.json"

# Logging & Environment
LOG_LEVEL="INFO"
LOG_FORMAT="json"
LOG_DIR="logs"
DEBUG=true
TIMEZONE="UTC"
