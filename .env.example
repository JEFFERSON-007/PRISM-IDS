# PRISM IDS Server Foundation - Environment Variables Example

APP_NAME="PRISM IDS Server"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
SERVER_HOST="0.0.0.0"
SERVER_PORT=8000
API_V1_STR="/api/v1"
TIMEZONE="UTC"

# Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="prism_user"
POSTGRES_PASSWORD="prism_secure_password"
POSTGRES_DB="prism_ids_db"
DATABASE_URL="postgresql+asyncpg://prism_user:prism_secure_password@localhost:5432/prism_ids_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# JWT Authentication
JWT_SECRET="super_secret_jwt_key_prism_ids_change_in_production_32bytes_min"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Logging Configuration
LOG_LEVEL="INFO"
LOG_FORMAT="json"
LOG_DIR="logs"

# CORS & Security Settings
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]
ALLOWED_HOSTS=["*"]

# WebSocket Settings
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=1000
